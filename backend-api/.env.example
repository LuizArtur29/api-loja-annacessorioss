# Copie para .env ao executar o backend diretamente pela IDE.
# Na DB_URL JDBC, usuário e senha ficam nas variáveis separadas abaixo.
DB_URL=jdbc:postgresql://localhost:5432/anna_erp
DB_USER=anna_erp
DB_PASSWORD=troque-por-uma-senha-local

# Gere com: openssl rand -base64 64
JWT_SECRET=troque-por-uma-chave-base64-de-pelo-menos-32-bytes
SPRINGDOC_ENABLED=true

CORS_ALLOWED_ORIGINS=http://localhost:5173
